# ==================== 数据库 ====================
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://spider:spider123@localhost:5432/spider_data

# ==================== LLM 配置（二选一或都配） ====================
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 千问（DashScope）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# 本地模型（可选，走 OpenAI 兼容接口）
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen2.5:1.5b

# ==================== 代理配置 ====================
# 纯自建模式：留空即可，框架自动从代理池获取
# 如需固定代理，填写如 http://user:pass@host:port
PROXY_FIXED=
PROXY_POOL_REFRESH_INTERVAL=300
PROXY_MAX_FAIL=3

# ==================== 爬虫全局 ====================
CONCURRENT_REQUESTS=16
DOWNLOAD_DELAY=1
RANDOMIZE_DOWNLOAD_DELAY=true
RETRY_TIMES=3
LOG_LEVEL=INFO

# ==================== 监控 ====================
PROMETHEUS_PORT=9100
